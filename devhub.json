{
  "description": "Прапор — 2D idle: коллекция пушек, убежище и рейды диких",
  "id": "prapor",
  "launch": {
    "dev": [
      "game"
    ]
  },
  "name": "Прапор",
  "services": [
    {
      "command": "bun x --no-install vite --host 127.0.0.1 --port 3020 --strictPort",
      "needs": ["prapor/accounts"],
      "health": "/",
      "id": "game",
      "name": "2D игра",
      "port": 3020,
      "ui": [
        {
          "label": "Играть",
          "url": "/"
        }
      ]
    },
    {
      "command": "bun server.ts",
      "health": "/health",
      "id": "accounts",
      "name": "Аккаунты и сохранения",
      "port": 3021,
      "env": {
        "NODE_ENV": "development",
        "HOST": "127.0.0.1",
        "PORT": "3021",
        "APP_ORIGINS": "http://127.0.0.1:3020,http://localhost:3020,http://127.0.0.1:3021",
        "ACCOUNT_DB_PATH": "F:/AI/prapor/accounts.sqlite"
      }
    }
  ]
}
