{
  "name": "prapor",
  "version": "0.15.0",
  "private": true,
  "type": "module",
  "description": "Прапор — 2D idle: коллекция пушек, убежище и рейды диких",
  "scripts": {
    "dev": "node .devhub/launch.cjs dev",
    "worktree": "node .devhub/worktree.cjs",
    "check": "tsc --noEmit",
    "test": "bun test --timeout 15000",
    "balance": "bun scripts/balance.ts",
    "balance:armory": "bun scripts/armory-balance.ts",
    "balance:strategy": "bun scripts/strategy-balance.ts",
    "balance:shelter": "bun scripts/shelter-balance.ts",
    "balance:loot": "bun scripts/loot-balance.ts",
    "world:generate": "bun scripts/world.ts",
    "build": "vite build",
    "start": "bun server.ts"
  },
  "dependencies": {
    "google-auth-library": "^11.3.0",
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.3",
    "typescript": "^6.0.3",
    "vite": "^8.3.4"
  }
}
