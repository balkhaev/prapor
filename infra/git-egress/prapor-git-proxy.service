[Unit]
Description=Prapor authenticated private Git HTTPS egress proxy
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
DynamicUser=yes
UMask=0077
LoadCredential=proxy_token:/etc/prapor-git-egress/proxy_token
ExecStart=/usr/bin/python3 /usr/local/lib/prapor-git-egress/proxy.py --credential-file %d/proxy_token
Environment=PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
Restart=always
RestartSec=5s
TimeoutStopSec=10s
KillMode=control-group
StandardInput=null
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
# The fixed listeners and upstream use literal IPv4 addresses; no DNS is needed.
RestrictAddressFamilies=AF_INET
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
InaccessiblePaths=-/data -/run/docker.sock
LimitNOFILE=256
TasksMax=128
MemoryMax=128M

[Install]
WantedBy=multi-user.target
